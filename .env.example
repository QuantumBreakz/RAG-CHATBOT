# XOR RAG Chatbot Environment Configuration

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=mistral:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Online Model API Keys (Optional - for enhanced performance)
# Add your API keys here to enable online model switching

# OpenAI API Key (for GPT-4, GPT-3.5, etc.)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=no

# Anthropic API Key (for Claude models)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
CHROMA_DB_PATH=./demo-rag-chroma
CHROMA_COLLECTION_NAME=xor_rag_collection

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Document Processing Configuration
MAX_FILE_SIZE=157286400  # 150MB in bytes
CHUNK_SIZE=600  # Default chunk size for document splitting
CHUNK_OVERLAP=200  # Default chunk overlap for document splitting
MAX_DOCUMENTS=50  # Maximum number of documents in knowledge base
VECTOR_DIMENSIONS=1536  # Vector embedding dimensions
N_RESULTS=10

# Cache Configuration
CACHE_TTL=3600  # Cache time-to-live in seconds
CACHE_ENABLED=true  # Enable/disable caching

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./log/xor_rag.log

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Security Configuration
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=./uploads

# OCR Configuration
TESSERACT_CMD=tesseract
POPPLER_PATH=/usr/local/bin

# Performance Configuration
MAX_CONCURRENT_UPLOADS=5
MAX_QUERY_LENGTH=4000
MAX_CONTEXT_LENGTH=8000

# Model Parameters (can be overridden in frontend settings)
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1000
